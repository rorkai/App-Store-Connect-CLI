---
const path = Astro.url.pathname.replace(/\/$/, '') || '/index';
const markdownPath = `${path}.md`;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const prompt = encodeURIComponent(`Read ${pageUrl} so I can ask questions about it.`);
const links = [
	{ label: 'View as Markdown', href: markdownPath },
	{ label: 'Open in ChatGPT', href: `https://chatgpt.com/?hints=search&q=${prompt}` },
	{ label: 'Open in Claude', href: `https://claude.ai/new?q=${prompt}` },
	{ label: 'Open in Perplexity', href: `https://www.perplexity.ai/search?q=${prompt}` },
];
---

<asc-copy-page class="copy-page not-content" data-markdown={markdownPath}>
	<button type="button" class="copy-page-button">
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" /><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" /></svg>
		<span data-label>Copy page</span>
	</button>
	<details class="copy-page-menu">
		<summary aria-label="More page actions">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
		</summary>
		<ul>
			{
				links.map((link) => (
					<li>
						<a href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
							{link.label}
						</a>
					</li>
				))
			}
		</ul>
	</details>
</asc-copy-page>

<script>
	class CopyPage extends HTMLElement {
		connectedCallback() {
			const button = this.querySelector('button')!;
			const label = this.querySelector('[data-label]')!;
			button.addEventListener('click', async () => {
				const response = await fetch(this.dataset.markdown!);
				await navigator.clipboard.writeText(await response.text());
				label.textContent = 'Copied';
				setTimeout(() => (label.textContent = 'Copy page'), 1500);
			});
		}
	}
	customElements.define('asc-copy-page', CopyPage);
</script>
